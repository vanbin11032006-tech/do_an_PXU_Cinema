# XAMPP MySQL (mặc định root không mật khẩu)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pxu_cinema

# API server
API_HOST=127.0.0.1
API_PORT=5000

# Để trống khi chạy `npm run dev` (Vite proxy /api -> API_PORT).
# Khi build tĩnh và gọi API khác origin, đặt ví dụ: http://localhost:5000
VITE_API_URL=

# Chế độ Supabase: chạy engine trong trình duyệt, lưu dữ liệu online trên Supabase.
# Điền cả 2 biến để bật (xem supabase/schema.sql). Bỏ trống để dùng API Express/MySQL.
# CẢNH BÁO: VITE_* bị nhúng vào bundle nên anon key là công khai.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
